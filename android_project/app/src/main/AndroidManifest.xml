<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.deka.ai">

    <!-- Network & Internet for Real AI API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Audio & Microphone for Hindi/English Voice Assistant -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Assistant wake-lock -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Queries for Android App Integration -->
    <queries>
        <!-- WhatsApp -->
        <package android:name="com.whatsapp" />
        <!-- YouTube -->
        <package android:name="com.google.android.youtube" />
        <!-- Gmail -->
        <package android:name="com.google.android.gm" />
        <!-- Google Maps -->
        <package android:name="com.google.android.apps.maps" />
        <!-- Chrome -->
        <package android:name="com.android.chrome" />
        <!-- Spotify -->
        <package android:name="com.spotify.music" />
        <!-- Camera Intent -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- Dial Intent -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <!-- Document Picker Intent -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DEKAAI"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DEKAAI"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android Assistant Intent Filter -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
